## host.conf.sample - annotated template for zfs-install.sh / zfs-mirror.sh
## Copy this to a file of your own (e.g. myhost.conf), edit the values, and pass
## its path as the first argument:
##
##   sudo ./zfs-install.sh /path/to/myhost.conf initial
##
## Keep real host configs OUT of this public repo - maintain them in your own
## private repo/directory and reference them by path.
## ============================================================================

## --- Required ----------------------------------------------------------------
DISKID="nvme-Samsung_SSD_980_PRO_1TB_S5XXXX" # primary disk's /dev/disk/by-id/ name (NO path prefix)
HOSTNAME="myhost"                            # system hostname
USERNAME="admin"                             # primary (sudo) user account
USERPASS="changeme"                          # password for the user and root; set securely, never commit a real one
TIMEZONE="UTC"                               # e.g. UTC, Europe/Amsterdam, America/New_York

## --- OS ----------------------------------------------------------------------
POOL_NAME="zroot"      # ZFS root pool name (default: zroot)
COMPRESSION="lz4"      # ZFS compression (default: lz4)
UBUNTU_VER="noble"     # Ubuntu release codename (default: noble = 24.04)
DISTRO="server"        # "server" or "kubuntu" (default: server)

## --- Boot / partitioning -----------------------------------------------------
BOOT_MODE="uefi"       # "uefi" (rEFInd) or "bios" (syslinux). Default: uefi
SWAP_SIZE="0"          # swap partition size in MB; 0 = no swap (default: 0)
ASHIFT="12"            # ZFS pool ashift; 12 = 4K sectors (default: 12)
BOOT_SIZE="512M"       # ESP/boot partition size (sgdisk syntax). 1G gives ZBM image headroom on headless boxes
ROOT_SIZE="0"          # 0 = root takes the whole disk. If set (e.g. 600G), root is bounded and the disk
                       # REMAINDER becomes a reserved BF00 partition (part3) for a later vdev (e.g. a ZFS
                       # special vdev). zfs-mirror.sh replicates this layout (incl. part3) to the mirror disk.

## --- Optional: static network ------------------------------------------------
## If set, this netplan YAML is installed verbatim as /etc/netplan/01-netplan.yaml.
## A relative path is resolved against the script directory. Unset = DHCP autoconfig.
## See examples/netplan-static.yaml for an annotated static-IP template to copy.
#NETPLAN_FILE="examples/netplan-static.yaml"

## --- Optional: SSH authorized_keys -------------------------------------------
## If set, this file of SSH public keys is copied verbatim into ~USERNAME/.ssh/
## authorized_keys at install (700 on .ssh, 600 on authorized_keys). Lets CI /
## config-management + operators reach the box before any password login. A
## relative path is resolved against the script directory. Unset = password-only.
#AUTHORIZED_KEYS="myhost.authorized_keys"

## --- Optional: pool feature compatibility ------------------------------------
## zpool 'compatibility' profile capping the root pool's enabled features. Set this
## when the environment you RUN the installer in has a NEWER ZFS than the installed
## distro will (otherwise the target can't import the pool at boot). The Hetzner
## rescue builds the LATEST OpenZFS while Ubuntu noble ships 2.2 -> pin to the
## target's release: openzfs-2.2-linux. See /usr/share/zfs/compatibility.d/ for the
## available profiles. Unset = enable all features the running ZFS supports.
#POOL_COMPATIBILITY="openzfs-2.2-linux"

## --- Optional: root mirror (for zfs-mirror.sh) -------------------------------
## The /dev/disk/by-id/ name of the second disk to attach as a root mirror.
#MIRRORDISKID="nvme-Samsung_SSD_980_PRO_1TB_S5YYYY"

## --- Optional: native ZFS encryption ------------------------------------------
## ENCRYPTION=on encrypts the pool root (aes-256-gcm, keyformat raw) - every
## dataset inherits it. The model:
##   - KEYFILE (raw 32 bytes, generate: head -c 32 /dev/urandom > myhost.key) is
##     used at install time and stored at /etc/zfs/<pool>.key INSIDE the
##     encrypted root; the target initramfs embeds it (and itself lives on the
##     encrypted root), so the key never touches plaintext storage.
##   - At boot, ZFSBootMenu unlocks the pool: unattended via ZBM_KEYFETCH_URL
##     (a plain unicast GET from the ZBM initramfs - use an IP-literal URL, there
##     is no DNS in the initramfs), or interactively at the console prompt.
##   - ZBM_NET_ARGS are dracut args baked onto the ZBM kernel commandline; they
##     configure static networking (incl. VLANs) inside the ZBM initramfs.
##     Required for ZBM_KEYFETCH_URL and ZBM_DROPBEAR.
##   - ZBM_DROPBEAR=on adds pubkey-only dropbear ssh to the ZBM image for remote
##     rescue of a stuck boot (diagnose, or paste a key manually:
##     zfs load-key -L file:///tmp/key <pool>). Gate the port in your upstream
##     firewall; open it only when needed.
## Keep KEYFILE with your private host configs - NEVER in this repo.
#ENCRYPTION="on"
#KEYFILE="myhost.key"
#ZBM_KEYFETCH_URL="https://10.0.0.2:8443/keys/myhost.key"
#ZBM_KEYFETCH_CA="myhost-keyserver-ca.pem"   # pin the key server's self-signed cert
#ZBM_NET_ARGS="rd.neednet=1 ip=10.0.0.10::10.0.0.1:255.255.255.0::vlan40:none vlan=vlan40:eth0"
#ZBM_DROPBEAR="on"
#ZBM_DROPBEAR_KEYS="myhost.authorized_keys"  # defaults to AUTHORIZED_KEYS
#ZBM_DROPBEAR_PORT="222"
#CMDLINE_EXTRA="console=tty0 console=ttyS0"  # serial-console visibility, iommu=pt, etc.
